{
  "manifest_version": 3,
  "name": "Smart Text Summarizer",
  "version": "1.0",
  "description": "Summarize selected text using Chrome's built-in AI",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Text Summarizer"
  },

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}