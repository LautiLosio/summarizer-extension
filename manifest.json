{
  "manifest_version": 3,
  "name": "Selection Summarizer",
  "version": "1.0",
  "description": "Summarize selected text using Chrome's built-in AI",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Selection Summarizer"
  },

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/AtkinsonHyperlegible-Regular.ttf",
        "fonts/AtkinsonHyperlegible-Bold.ttf",
        "fonts/AtkinsonHyperlegible-Italic.ttf",
        "fonts/AtkinsonHyperlegible-BoldItalic.ttf"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
